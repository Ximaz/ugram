generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String   @unique
  hashedPassword String   @map("hashed_password") @default("")
  firstname      String
  lastname       String
  phoneNumber    String   @map("phone_number") @default("")
  profilePicture String   @map("profile_picture") @default("")
  createdAt      DateTime @default(now()) @map("created_at")

  posts           Post[]
  mentionedInPosts Post[] @relation("PostMentions")

  @@map("user")
}

model Post {
  id          String   @id @default(uuid())
  description String
  image       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId   String @map("user_id")

  /// Also known as 'hashtags'
  keywords PostKeyword[] @relation("PostKeywords")

  /// Mentioned users — join table managed by Prisma
  mentions User[] @relation("PostMentions")

  @@index([createdAt(sort: Desc)])
  @@map("post")
}

model PostKeyword {
  id      String @id @default(uuid())
  value   String @unique

  posts   Post[] @relation("PostKeywords")

  @@index([value])
  @@map("post_keyword")
}